<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lottery.Views.MainPage"
             Title="Losowanie osoby do odpowiedzi">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Dodaj klasę:" />
        <HorizontalStackLayout>
            <Entry x:Name="ClassEntry" Placeholder="Nazwa klasy" />
            <Button Text="Dodaj" Clicked="OnAddClassClicked" />
        </HorizontalStackLayout>

        <Picker x:Name="ClassPicker" Title="Wybierz klasę"
                SelectedIndexChanged="OnClassSelected" />

        <Label Text="Dodaj ucznia:" />
        <HorizontalStackLayout>
            <Entry x:Name="StudentEntry" Placeholder="Imię ucznia" />
            <Button Text="Dodaj" Clicked="OnAddStudentClicked" />
        </HorizontalStackLayout>

        <Button Text="Wylosuj ucznia" Clicked="OnDrawStudentClicked" />
        <Label x:Name="ResultLabel" />

    </VerticalStackLayout>
</ContentPage>
